{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "x-vercel-ip-country",
          "value": "IT"
        }
      ],
      "destination": "/it/",
      "permanent": false
    },
    {
      "source": "/",
      "destination": "/en/",
      "permanent": false,
      "missing": [
        {
          "type": "header",
          "key": "x-vercel-ip-country",
          "value": "IT"
        }
      ]
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store, max-age=0"
        },
        {
          "key": "Vary",
          "value": "x-vercel-ip-country"
        }
      ]
    }
  ],
  "functions": {
    "api/contact.js": {
      "maxDuration": 30
    }
  }
}
